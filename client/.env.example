# This demo has NO backend of its own — checkout is a dummy flow and
# payment records live in the browser (localStorage). The only server it
# talks to is the Webruit API. The only secret-ish value is the admin
# password for the /admin view (checked in the browser, demo-grade).
VITE_ADMIN_PASSWORD=

# Webruit browser SDK (public pk_ key only)
# Production needs NO endpoint config: the packages default to the hosted
# Webruit Cloud (https://api.webruit.tech). The domain/URL vars below only
# point the demo at a LOCAL Webruit API during development
# (use http://localhost:3000 there).
VITE_WEBRUIT_PROJECT_KEY=pk_live_xxx
VITE_WEBRUIT_DOMAIN=
# optional explicit overrides
VITE_WEBRUIT_API_URL=
VITE_WEBRUIT_TRACK_ENDPOINT=

# Webruit build plugin (build/CI only, never exposed to the browser)
# Same default: manifest uploads go to https://api.webruit.tech unless
# WEBRUIT_API_URL / WEBRUIT_DOMAIN say otherwise.
WEBRUIT_PROJECT_ID=
WEBRUIT_SECRET_KEY=sk_live_xxx
WEBRUIT_DOMAIN=
WEBRUIT_API_URL=