# Dev defaults need nothing: shop API http://localhost:5000, Webruit API http://localhost:3000.
# Prod: set the domains (or explicit URLs) at build time.
VITE_SHOP_API_DOMAIN=
VITE_API_URL=
VITE_ADMIN_PASSWORD=

# Webruit browser SDK (public pk_ key only)
VITE_WEBRUIT_PROJECT_KEY=pk_live_xxx
VITE_WEBRUIT_DOMAIN=
# optional explicit overrides
VITE_WEBRUIT_API_URL=
VITE_WEBRUIT_TRACK_ENDPOINT=

# Webruit build plugin (build/CI only, never exposed to the browser)
WEBRUIT_PROJECT_ID=
WEBRUIT_SECRET_KEY=sk_live_xxx
WEBRUIT_DOMAIN=
WEBRUIT_API_URL=